@layout()
  @vite(['resources/css/pages/login.css'])

  <section class="signup-page login-page">
    <aside class="signup-showcase" aria-label="RoadAlert">
      <div class="signup-showcase__content">
        <a href="{{ route('home') }}" class="signup-brand" aria-label="RoadAlert, accueil"><span class="signup-brand__icon">⚠</span><strong>Road<span>Alert</span></strong></a>
        <div class="signup-showcase__intro"><h1>Ensemble, rendons<br />nos routes plus sûres.</h1><p>Signalez les problèmes routiers autour de vous et contribuez à l'amélioration de nos infrastructures.</p></div>
        <div class="signup-benefits">
          <div class="signup-benefit"><i>⌖</i><p><strong>Signalez facilement</strong><span>Indiquez un problème routier en quelques clics avec photos et localisation.</span></p></div>
          <div class="signup-benefit"><i>▥</i><p><strong>Suivez en temps réel</strong><span>Suivez l'état de vos signalements et restez informé des actions menées.</span></p></div>
          <div class="signup-benefit"><i>♧</i><p><strong>Agissons ensemble</strong><span>Votre signalement peut faire la différence pour toute la communauté.</span></p></div>
        </div>
        <div class="signup-security"><i>♢</i><p><strong>Votre sécurité, notre priorité</strong><span>RoadAlert garantit la confidentialité de vos données et signalements.</span></p></div>
        <small class="signup-copyright">© 2025 Road<span>Alert</span>. Tous droits réservés.</small>
      </div>
    </aside>

    <div class="signup-panel">
      <div class="signup-panel__top"><a href="{{ route('home') }}" class="signup-back">← <span>Retour à l'accueil</span></a><button class="signup-theme" type="button" aria-label="Changer le thème">☼ <span>◐</span></button></div>
      <div class="signup-card login-card">
        <div class="signup-card__heading"><div class="signup-lock">♙</div><h2>Connexion</h2><p>Connectez-vous à votre compte RoadAlert<br />pour continuer.</p></div>
        @form({ route: 'session.store', method: 'POST', class: 'signup-form' })
          @field.root({ name: 'email' })
            @!field.label({ text: 'Adresse email' })
            <div class="signup-input">
              <span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail-icon lucide-mail"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg></span>
              @!input.control({ type: 'email', autocomplete: 'email', placeholder: 'Entrez votre email' })
            </div>
            @!field.error()
          @end
          @field.root({ name: 'password' })
            @!field.label({ text: 'Mot de passe' })
            <div class="signup-input">
              <span>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-keyhole-icon lucide-lock-keyhole"><circle cx="12" cy="16" r="1"/><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg>
              </span>
              @!input.control({ type: 'password', autocomplete: 'current-password', placeholder: 'Entrez votre mot de passe' })
            </div>
            @!field.error()
          @end
          <a href="#" class="login-forgot">Mot de passe oublié ?</a>
          <button class="signup-submit" type="submit">Se connecter <span>→</span></button>
        @end
        <div class="login-divider"><span>ou continuer avec</span></div>
        <div class="login-socials"><button type="button"><b class="google-mark">G</b>Google</button><button type="button"><b class="facebook-mark">f</b>Facebook</button></div>
        <p class="signup-login">Vous n'avez pas de compte ? <a href="{{ route('new_account.create') }}">S'inscrire</a></p>
      </div>
      <p class="signup-data-security">♢ <span>Vos données sont sécurisées<br />et ne seront jamais partagées.</span></p>
    </div>
  </section>
@end
